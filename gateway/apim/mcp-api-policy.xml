<!--
  Azure API Management policy for the Beast Assist MCP API (Consumption tier).
  Inbound order: reject without a valid Entra token -> require the skill header -> pass the caller's
  identity and the skill header through to the MCP servers, which validate the token AGAIN (defence in
  depth) and ask OPA about the skill's allowed_tools.
  {{tenant-id}} and {{audience}} are APIM named values set by gateway/azure/setup.sh.
  No per-client rate limit: Consumption rejects rate-limit-by-key ("Policy is not allowed in 'Consumption' sku").
  On Developer/Standard, add one after check-header, keyed on the token's azp claim (the calling app).
-->
<policies>
  <inbound>
    <base />
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401"
                  failed-validation-error-message="A valid Entra ID token for Beast Assist is required"
                  require-scheme="Bearer" output-token-variable-name="jwt">
      <openid-config url="https://login.microsoftonline.com/{{tenant-id}}/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>{{audience}}</audience>
      </audiences>
      <issuers>
        <issuer>https://login.microsoftonline.com/{{tenant-id}}/v2.0</issuer>
      </issuers>
      <required-claims>
        <claim name="roles" match="any">
          <value>Tools.Read</value>
          <value>Tools.Write</value>
        </claim>
      </required-claims>
    </validate-jwt>
    <!-- every MCP call must say which skill it runs under; OPA decides what that skill may do -->
    <check-header name="X-Skill-Id" failed-check-httpcode="400"
                  failed-check-error-message="X-Skill-Id header is required" ignore-case="true" />
    <set-header name="X-Caller-Oid" exists-action="override">
      <value>@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("oid", ""))</value>
    </set-header>
    <set-header name="X-Request-Id" exists-action="skip">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </inbound>
  <backend>
    <!-- MCP responses are small JSON; no buffering tricks needed. 60 s covers a slow backend. -->
    <forward-request timeout="60" />
  </backend>
  <outbound>
    <base />
    <set-header name="X-Powered-By" exists-action="delete" />
    <!-- evidence for callers: which gateway, region and request answered (also on refusals, below) -->
    <set-header name="X-Beast-Gateway" exists-action="override">
      <value>@("azure-api-management/" + context.Deployment.Region + "/" + context.Deployment.ServiceName)</value>
    </set-header>
    <set-header name="X-Beast-Gateway-Request-Id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
    <!-- the same evidence on refusals (401 from validate-jwt, 400 from check-header) -->
    <set-header name="X-Beast-Gateway" exists-action="override">
      <value>@("azure-api-management/" + context.Deployment.Region + "/" + context.Deployment.ServiceName)</value>
    </set-header>
    <set-header name="X-Beast-Gateway-Request-Id" exists-action="override">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </on-error>
</policies>
